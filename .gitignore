# ==============================================================================
# SECRETS, API KEYS & CREDENTIALS (NEVER COMMIT)
# ==============================================================================
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
*_key.txt
usage_records.json

# ==============================================================================
# PYTHON, CACHES & VIRTUAL ENVIRONMENTS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.deepeval/
.cache/
logs/
scratch/
.DS_Store
Thumbs.db
ehthumbs.db

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# LARGE RAW FILES (EXCEED GITHUB 100MB LIMIT)
# ==============================================================================
# Income-tax-Act-2025_...pdf is 112.71 MB (GitHub hard rejection limit is 100 MB).
# Raw source PDFs are not needed by the deployed app because ChromaDB and chunks
# are already pre-parsed and indexed.
*.pdf

# ==============================================================================
# CRITICAL APP DATA (KEPT IN REPOSITORY FOR STREAMLIT CLOUD DEPLOYMENT)
# ==============================================================================
# Vector database: Required for retrieval on Streamlit Cloud (~38 MB total)
!chroma_db/
!chroma_db/**

# Pre-indexed document chunks: Required by RAG answer generation (~4.6 MB)
!parsed_docs/
!parsed_docs/**
