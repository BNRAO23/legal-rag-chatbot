# Set the API key for your embedding provider (Google Gemini or OpenAI):
# GEMINI_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Optional overrides (shared by build_vector_db.py and future query scripts):
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-001
# CHUNKS_PATH=parsed_docs/chunks.jsonl
# CHROMA_DIR=chroma_db
# CHROMA_COLLECTION=ca_legal_rag
# EMBED_BATCH_SIZE=64

